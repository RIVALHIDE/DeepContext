# Local development defaults. Never commit real credentials.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Leave DATABASE_URL empty locally to use backend/data/users.db.
DATABASE_URL=
SQLITE_DB_PATH=
REDIS_URL=redis://localhost:6379/0
# Use "chroma" locally. The no-card cloud deployment uses "postgres" so
# vectors persist in Neon PostgreSQL through pgvector.
VECTOR_STORE_BACKEND=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION_NAME=deepcontext_v2
CELERY_TASK_ALWAYS_EAGER=false

JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

NEXCONN_API_BASE_URL=https://api.sg-light-api.com
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA_CODE=sg

# Production shared storage (Neon Object Storage or another S3 provider).
# Leave S3_BUCKET empty to store files locally.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

HUGGINGFACE_LOCAL_FILES_ONLY=false
RERANK_ENABLED=false
